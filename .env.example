# Copy to .env.local for development. Every integration is optional:
# without keys the site runs in demo mode locally and disables that feature
# in production. See docs/LAUNCH.md for where each value comes from.

# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3217
DATABASE_URL=postgres://localhost:5432/jodz_dev
# openssl rand -base64 32
AUTH_SECRET=
# Comma-separated. These emails get dashboard access at /admin.
ADMIN_EMAILS=

# Company details (footer, legal pages, structured data)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_CRO=
NEXT_PUBLIC_COMPANY_VAT=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Commerce: auto picks shopify (Storefront token) > permalink (domain only) > demo (dev only)
COMMERCE_MODE=auto
SHOPIFY_STORE_DOMAIN=j10n8r-0b.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Admin API: read_orders, read_products, read_inventory, write_discounts, write_draft_orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
# Customer account page (Shopify > Settings > Customer accounts), linked from Track an order
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=

# Email marketing
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
# Optional: Klaviyo API revision date
KLAVIYO_REVISION=

# Meta ads (Marketing API, read-only system user token with ads_read)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0
NEXT_PUBLIC_META_PIXEL_ID=

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA4_ID=

# Transactional email (sign-in links, confirmations, notifications)
RESEND_API_KEY=
EMAIL_FROM=Jod-Z <hello@jod-z.com>
# Where new applications and contact messages are sent
EMAIL_NOTIFY=

# Bot protection on forms (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Error monitoring
NEXT_PUBLIC_SENTRY_DSN=
